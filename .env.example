# Global LLM for document chat, analysis and comparison: groq, openai or google.
LLM_PROVIDER=groq
# Optional provider override for chat only. Leave blank to inherit LLM_PROVIDER.
CHAT_LLM_PROVIDER=

# Add the key for each selected provider. Set its model ID to override the default.
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3.5-flash-lite

# Embeddings use a separate setting and key.
EMBEDDING_PROVIDER=huggingface
HF_TOKEN=

# Optional LangSmith tracing. Set PROJECT to the environment's tracer_session_name.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com


# LLM_PROVIDER=openai
# CHAT_LLM_PROVIDER=
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_CHAT_MODEL=gpt-4.1-mini

